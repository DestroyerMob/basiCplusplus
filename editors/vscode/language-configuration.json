{
  "comments": { "lineComment": "//", "blockComment": ["/*", "*/"] },
  "brackets": [["(", ")"], ["[", "]"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")", "notIn": ["string", "comment"] },
    { "open": "[", "close": "]", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["(", ")"], ["[", "]"], ["\"", "\""]],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:fn|func|function|struct|if|else|while|for)\\b.*|unsafe\\s*):\\s*(?://.*)?$",
    "decreaseIndentPattern": "^\\s*else\\b.*:\\s*(?://.*)?$"
  },
  "folding": { "offSide": true }
}
